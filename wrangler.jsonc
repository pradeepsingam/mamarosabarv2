{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mamarosabarv2",
  "compatibility_date": "2026-10-25",
  "main": "cloudflare/worker.mjs",
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
