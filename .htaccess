# Apache 2.4 deployment: enable mod_rewrite and AllowOverride FileInfo Options.
DirectoryIndex index.html
Options -Indexes -MultiViews
ErrorDocument 404 /404.html

RewriteEngine On
# Combine the homepage path and host/protocol change into one production redirect.
RewriteCond %{HTTP_HOST} ^(?:www\.)?mamarosabar\.ca$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://mamarosabar.ca/ [R=301,L]

# Apply production host/protocol redirects only to the configured domain.
RewriteCond %{HTTP_HOST} ^(?:www\.)?mamarosabar\.ca$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://mamarosabar.ca%{REQUEST_URI} [R=301,L,NE]

# Consolidate the homepage path. No SPA catch-all: missing URLs must remain 404.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
